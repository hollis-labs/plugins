#!/usr/bin/env python3
"""Plugin descriptor guard.

Usage: scripts/check-plugins [--plugin NAME] [--no-tags]

Every top-level directory except the reserved ones is a plugin and must hold:
  - <plugin>/go.mod, module path github.com/hollis-labs/plugins/<plugin> (plus /vN for N >= 2),
    with a go directive, and no replace directive;
  - <plugin>/plugin.json, the monorepo-owned descriptor, strict JSON with exactly the keys
        {"name": "<plugin>", "kind": "connector"|"provider"|"module", "hosts": ["cerberus", ...]}
    unknown, missing and duplicate keys are rejected; name equals the directory; hosts is a
    non-empty array of unique lower-case ids ([a-z][a-z0-9_-]*);
  - if a v2 manifest <plugin>/plugin.yaml or plugin.yml has a top-level `kind:` field, it
    equals the descriptor's kind (a plugin.json at the plugin root IS the descriptor, so a
    plugin's own manifest cannot live there).
Descriptor names are unique across the repository. Unless --no-tags, every local tag must be
<plugin>/vX.Y.Z for an existing plugin (no bare vX.Y.Z, no tag for an unknown plugin).
--plugin NAME limits the per-plugin checks to one plugin (used by scripts/release).
Standard library only. Exits 1 on any failure.
"""
import argparse
import json
import os
import re
import subprocess
import sys

MODULE_PREFIX = "github.com/hollis-labs/plugins"
RESERVED = {"scripts", ".github", "scan-public.allow.d", "docs"}
KINDS = ("connector", "provider", "module")
HOST_RE = re.compile(r"^[a-z][a-z0-9_-]*$")
NAME_RE = re.compile(r"^[a-z0-9][a-z0-9._-]*$")
SEMVER = r"v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(-[0-9A-Za-z]+(\.[0-9A-Za-z-]+)*)?"
TAG_RE = re.compile(r"^([a-z0-9][a-z0-9._-]*)/" + SEMVER + "$")

fail = False


def bad(msg):
    global fail
    fail = True
    print("FAIL: " + msg, file=sys.stderr)


def reject_dupes(pairs):
    d = {}
    for k, v in pairs:
        if k in d:
            raise ValueError("duplicate key %r" % k)
        d[k] = v
    return d


def repo_root():
    here = os.path.dirname(os.path.abspath(__file__))
    return os.path.abspath(os.path.join(here, ".."))


def files(root):
    out = subprocess.run(["git", "-C", root, "ls-files", "--cached", "--others", "--exclude-standard"],
                         check=True, capture_output=True, text=True).stdout
    return [f for f in out.split("\n") if f and os.path.lexists(os.path.join(root, f))]


def check_descriptor(root, d):
    """Return the descriptor dict, or None after reporting why not."""
    p = os.path.join(root, d, "plugin.json")
    if not os.path.lexists(p):
        bad("%s: missing %s/plugin.json (the monorepo-owned descriptor)" % (d, d))
        return None
    if os.path.islink(p) or not os.path.isfile(p):
        bad("%s/plugin.json: must be a regular file" % d)
        return None
    try:
        with open(p, encoding="utf-8") as fh:
            desc = json.load(fh, object_pairs_hook=reject_dupes)
    except (ValueError, UnicodeDecodeError) as e:
        bad("%s/plugin.json: not valid strict JSON (%s)" % (d, e))
        return None
    if not isinstance(desc, dict):
        bad("%s/plugin.json: must be a JSON object" % d)
        return None
    ok = True
    for k in sorted(set(desc) - {"name", "kind", "hosts"}):
        bad("%s/plugin.json: unknown field %r (allowed: name, kind, hosts)" % (d, k))
        ok = False
    for k in ("name", "kind", "hosts"):
        if k not in desc:
            bad("%s/plugin.json: missing field %r" % (d, k))
            ok = False
    if not ok:
        return None
    if desc["name"] != d:
        bad("%s/plugin.json: name is %r; it must equal the directory %r" % (d, desc["name"], d))
        ok = False
    if desc["kind"] not in KINDS or not isinstance(desc["kind"], str):
        bad("%s/plugin.json: kind is %r; want one of %s" % (d, desc["kind"], ", ".join(KINDS)))
        ok = False
    h = desc["hosts"]
    if not isinstance(h, list) or not h:
        bad("%s/plugin.json: hosts must be a non-empty array" % d)
        ok = False
    else:
        for x in h:
            if not isinstance(x, str) or not HOST_RE.match(x):
                bad("%s/plugin.json: host %r is not a lower-case id ([a-z][a-z0-9_-]*)" % (d, x))
                ok = False
        if len(set(h)) != len(h):
            bad("%s/plugin.json: hosts has duplicates" % d)
            ok = False
    return desc if ok else None


def check_gomod(root, d):
    p = os.path.join(root, d, "go.mod")
    if not os.path.isfile(p):
        bad("%s: no %s/go.mod; every plugin is a Go module" % (d, d))
        return
    with open(p, encoding="utf-8") as fh:
        text = fh.read()
    m = re.search(r"^module\s+(\S+)", text, re.M)
    want = "%s/%s" % (MODULE_PREFIX, d)
    path = m.group(1).strip('"') if m else ""
    if not re.match("^" + re.escape(want) + r"(/v[2-9][0-9]*)?$", path):
        bad("%s/go.mod: module path is %r; want %r (or %r/vN for N >= 2)" % (d, path, want, want))
    if not re.search(r"^go\s+[0-9]+\.[0-9]+", text, re.M):
        bad("%s/go.mod: no go directive" % d)
    if re.search(r"^\s*replace(\s|\()", text, re.M):
        bad("%s/go.mod: replace directive; consumers cannot resolve it" % d)


def check_manifest(root, d, desc):
    for fn in ("plugin.yaml", "plugin.yml"):
        p = os.path.join(root, d, fn)
        if not os.path.isfile(p):
            continue
        with open(p, encoding="utf-8", errors="replace") as fh:
            for line in fh:
                m = re.match(r"""^kind\s*:\s*["']?([A-Za-z0-9_-]+)["']?\s*(#.*)?$""", line.rstrip("\n"))
                if m:
                    if desc is not None and m.group(1) != desc["kind"]:
                        bad("%s/%s: manifest kind %r differs from the descriptor kind %r"
                            % (d, fn, m.group(1), desc["kind"]))
                    break


def main():
    ap = argparse.ArgumentParser(description="Check plugin directories, descriptors and tags.")
    ap.add_argument("--plugin")
    ap.add_argument("--no-tags", action="store_true")
    ap.add_argument("--repo", default=repo_root())
    args = ap.parse_args()
    root = args.repo

    tops = sorted({f.split("/", 1)[0] for f in files(root) if "/" in f} - RESERVED)
    if args.plugin:
        if args.plugin not in tops:
            bad("%s: not a plugin directory here" % args.plugin)
            sys.exit(1)
        selected = [args.plugin]
    else:
        selected = tops

    names = {}
    for d in selected:
        if not NAME_RE.match(d):
            bad("%s: not a valid plugin directory name" % d)
        desc = check_descriptor(root, d)
        check_gomod(root, d)
        check_manifest(root, d, desc)
        if desc is not None:
            key = desc["name"].lower()
            if key in names:
                bad("%s/plugin.json: descriptor name %r is already used by %s" % (d, desc["name"], names[key]))
            names[key] = d

    if not args.no_tags and not args.plugin:
        tags = subprocess.run(["git", "-C", root, "tag", "--list"], capture_output=True, text=True).stdout.split()
        for t in tags:
            m = TAG_RE.match(t)
            if not m:
                bad("tag %s: not <plugin>/vX.Y.Z (no bare vX.Y.Z, no repository-wide version)" % t)
            elif m.group(1) not in tops:
                bad("tag %s: %s is not a plugin directory here" % (t, m.group(1)))

    if fail:
        sys.exit(1)
    print("ok: plugins (%d: %s)" % (len(selected), " ".join(selected)))


if __name__ == "__main__":
    main()
