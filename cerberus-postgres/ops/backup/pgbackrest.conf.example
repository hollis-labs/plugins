# Render with a private secrets file at deployment; never commit real values.
# This file is mounted read-only at /etc/pgbackrest/pgbackrest.conf, mode0600,
# owned by the image's postgres uid. Store its encryption key off-host too.
[shared]
pg1-path=/var/lib/postgresql/data
pg1-port=5432
pg1-socket-path=/var/run/postgresql

[global]
repo1-type=s3
repo1-path=/cerberus/postgres/shared
repo1-s3-bucket=REVIEW_REQUIRED
repo1-s3-endpoint=REVIEW_REQUIRED
repo1-s3-region=REVIEW_REQUIRED
repo1-s3-uri-style=path
repo1-s3-key=PRIVATE_DEPLOYMENT_VALUE
repo1-s3-key-secret=PRIVATE_DEPLOYMENT_VALUE
repo1-storage-verify-tls=y
repo1-cipher-type=aes-256-cbc
repo1-cipher-pass=PRIVATE_RECOVERY_KEY
repo1-retention-full=7
repo1-retention-full-type=count
repo1-retention-history=30
start-fast=y
process-max=2
archive-timeout=60
io-timeout=30
protocol-timeout=120
log-level-console=error
log-level-file=info
log-path=/var/log/pgbackrest
lock-path=/var/run/pgbackrest

# Synchronous archiving: a repository failure never acknowledges a lost WAL
# segment. PG retains WAL on failure; alert on failure/lag and disk pressure.
archive-async=n
