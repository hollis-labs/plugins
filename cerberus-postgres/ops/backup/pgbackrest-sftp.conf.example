# Complete with reviewed private mounted key/config paths before use.
[shared]
pg1-path=/var/lib/postgresql/data
pg1-port=5432
pg1-socket-path=/var/run/postgresql
[global]
repo1-type=sftp
repo1-path=/backups/cerberus/postgres/shared
repo1-sftp-host=REVIEW_REQUIRED.example.test
repo1-sftp-host-user=REVIEW_REQUIRED
repo1-sftp-host-port=22
repo1-sftp-host-key-check-type=strict
repo1-sftp-host-key-hash-type=sha256
repo1-sftp-known-host=/etc/pgbackrest/known_hosts
repo1-sftp-private-key-file=/etc/pgbackrest/id_ed25519
repo1-cipher-type=aes-256-cbc
repo1-cipher-pass=PRIVATE_RECOVERY_KEY
repo1-retention-full=7
repo1-retention-full-type=count
repo1-retention-history=30
start-fast=y
process-max=2
archive-async=n
archive-timeout=60
io-timeout=30
protocol-timeout=120
log-level-console=error
log-level-file=info
log-path=/var/log/pgbackrest
lock-path=/var/run/pgbackrest
