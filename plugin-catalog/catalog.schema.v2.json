{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 2
    },
    "catalog_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "plugins": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Plugin"
      }
    }
  },
  "required": [
    "schema_version",
    "catalog_version",
    "generated_at",
    "plugins"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hollislabs.com/plugins/catalog.schema.v2.json",
  "title": "Portfolio plugin catalog v2",
  "description": "Multi-host plugin distribution and directory metadata. SHA-256 checksums detect changed bytes; publisher trust is an install decision. No signing, tiers or compiled-in plugins.",
  "$defs": {
    "Plugin": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+([.-][a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
        },
        "license": {
          "type": "string"
        },
        "homepage": {
          "type": "string",
          "format": "uri"
        },
        "repository": {
          "type": "string",
          "format": "uri"
        },
        "hosts": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z0-9]+([.-][a-z0-9]+)*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/HostRange"
          }
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "git"
            },
            "repo": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            },
            "tag": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "type",
            "repo",
            "tag"
          ]
        },
        "archives": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Archive"
          },
          "minItems": 1
        },
        "manifest_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "directory": {
          "$ref": "#/$defs/Directory"
        },
        "summary": {
          "$ref": "#/$defs/Summary"
        }
      },
      "required": [
        "id",
        "name",
        "version",
        "hosts",
        "source",
        "archives",
        "manifest_sha256",
        "directory",
        "summary"
      ]
    },
    "HostRange": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
        },
        "max": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
        }
      },
      "required": [],
      "anyOf": [
        {
          "required": [
            "min"
          ]
        },
        {
          "required": [
            "max"
          ]
        }
      ]
    },
    "Archive": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "platform": {
          "enum": [
            "darwin-amd64",
            "darwin-arm64",
            "linux-amd64",
            "linux-arm64",
            "windows-amd64",
            "windows-arm64"
          ]
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "platform",
        "url",
        "sha256",
        "size"
      ]
    },
    "Directory": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "icon": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "screenshots": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "categories": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "short_desc": {
          "type": "string"
        },
        "readme_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "status": {
          "enum": [
            "active",
            "deprecated",
            "experimental"
          ]
        }
      },
      "required": [
        "status"
      ]
    },
    "Summary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "capabilities": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string"
              },
              "optional": {
                "type": "boolean"
              },
              "metadata": {}
            },
            "required": [
              "name"
            ]
          }
        },
        "operations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string"
              },
              "effect": {
                "type": "string",
                "minLength": 1
              },
              "host": {
                "type": "string",
                "pattern": "^[a-z0-9]+([.-][a-z0-9]+)*$"
              }
            },
            "required": [
              "name",
              "effect"
            ]
          }
        },
        "effects": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "capabilities",
        "operations",
        "effects"
      ]
    }
  }
}
